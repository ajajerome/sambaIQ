{
  "expo": {
    "name": "SambaIQ - Duolingo för Fotboll",
    "slug": "sambaiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B04F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sambaiq.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Vi använder kameran för att ta bilder av din avatar.",
        "NSPhotoLibraryUsageDescription": "Vi använder fotobiblioteket för att välja avatar-bilder."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00B04F"
      },
      "package": "com.sambaiq.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "sambaiq",
    "extra": {
      "eas": {
        "projectId": "79a4b7f6-bc77-4c19-a23d-b8317c1c1f43"
      }
    },
    "owner": "jappmaster"
  }
}
